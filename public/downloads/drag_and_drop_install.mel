// =============================================================================
// AnimationReference.org - Maya Drag & Drop Installer
// Drag and drop this file directly into the Maya 3D Viewport!
// =============================================================================

global proc onMayaDroppedAndLoaded(string $dropPath) {
    string $dir = `dirname $dropPath`;
    $dir = `substituteAllString $dir "\\" "/"`;
    string $pyFile = $dir + "/drag_and_drop_install.py";
    
    if (`file -q -ex $pyFile`) {
        python("exec(open(r'" + $pyFile + "', encoding='utf-8').read())");
    } else {
        python("import animref_studio; animref_studio.show_installer_wizard()");
    }
}

// Fallback: If Maya sources this script directly on drop
{
    string $dropDir = "C:/Users/micha/OneDrive/Documents/Github/Animationreference.org/public/downloads/animref_maya_plugin";
    string $py = $dropDir + "/drag_and_drop_install.py";
    if (`file -q -ex $py`) {
        python("exec(open(r'" + $py + "', encoding='utf-8').read())");
    } else {
        python("import animref_studio; animref_studio.show_installer_wizard()");
    }
}
