rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check for admin privileges
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Portfolio media and thumbnails: publicly readable for all users and community feed.
    // Unconditionally allow write so browser client auth state desync never blocks storage uploads.
    match /portfolio/{allPaths=**} {
      allow read, write: if true;
    }

    // Reference uploads and clips: fully accessible for uploads like social media platforms
    match /reference-uploads/{allPaths=**} {
      allow read, write: if true;
    }
    match /reference_clips/{allPaths=**} {
      allow read, write: if true;
    }
    match /references/{allPaths=**} {
      allow read, write: if true;
    }
    match /clips/{allPaths=**} {
      allow read, write: if true;
    }
    match /private-reference/{allPaths=**} {
      allow read, write: if true;
    }

    // General media and social uploads
    match /uploads/{allPaths=**} {
      allow read, write: if true;
    }
    match /shorts/{allPaths=**} {
      allow read, write: if true;
    }
    match /videos/{allPaths=**} {
      allow read, write: if true;
    }
    match /thumbnails/{allPaths=**} {
      allow read, write: if true;
    }
    match /posters/{allPaths=**} {
      allow read, write: if true;
    }
    match /users/{allPaths=**} {
      allow read, write: if true;
    }
    match /avatars/{allPaths=**} {
      allow read, write: if true;
    }
    match /moodboard_uploads/{allPaths=**} {
      allow read, write: if true;
    }

    // Catch-all: allow public read and authenticated write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
