rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for an admin user
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Mirrors getEntitlements(...).isPro in src/lib/plans.ts: admins, SJSU/VIP
    // passes, and paid Pro plans whose subscription hasn't ended.
    function profileIsPro(p) {
      return p.get('role', 'user') == 'admin'
        || p.get('tier', '') == 'student_unlimited'
        || p.get('isVIP', false) == true
        || p.get('unlimitedAccess', false) == true
        || (p.get('isPremium', false) == true
            && !(p.get('subscriptionStatus', '') in ['canceled', 'unpaid', 'incomplete_expired', 'incomplete', 'paused'])
            && (p.get('plan', '') in ['pro_monthly', 'pro_annual', 'tier5'] || p.get('tier', '') == 'tier5'));
    }

    function isPro() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profileIsPro(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // Making something private (boards, clips) is a Pro feature; keeping an
    // existing private item private is always allowed.
    function privacyAllowed() {
      return request.resource.data.get('isPrivate', false) != true
        || (resource != null && resource.data.get('isPrivate', false) == true)
        || isPro();
    }

    function canReadBoard(boardId) {
      return get(/databases/$(database)/documents/reference_boards/$(boardId)).data.isPrivate == false ||
        (request.auth != null && get(/databases/$(database)/documents/reference_boards/$(boardId)).data.ownerId == request.auth.uid) || isAdmin();
    }

    // --- App Specific Rules ---

    // Videos, Categories, Folders, etc: Public read, Admin write
    match /videos/{videoId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource.data.get('uploaderId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
      // Any signed-in user may move the like counter by exactly one, and
      // anyone may bump the view counter. hasOnly() keeps every other field
      // owner/admin-only.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && (
          request.resource.data.likeCount == resource.data.get('likeCount', 0) + 1
          || request.resource.data.likeCount == resource.data.get('likeCount', 0) - 1
        );
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount is int
        && request.resource.data.viewCount == resource.data.get('viewCount', 0) + 1;
    }
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /folders/{folderId} { allow read: if true; allow write: if isAdmin(); }
    match /marketplace_products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /tags/{tagId} { allow read: if true; allow write: if isAdmin(); }
    match /shortFilmCategories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /shortFilmTags/{tagId} { allow read: if true; allow write: if isAdmin(); }
    match /animationreference/{refId} { allow read: if true; allow write: if isAdmin(); }
    match /blogPosts/{postId} { allow read: if true; allow write: if isAdmin(); }

    // Partner API keys and their usage counters are server-only. They hold key
    // hashes and are written by the Admin SDK, which bypasses these rules; no
    // client, admin included, has any reason to read them.
    match /partner_keys/{keyHash} { allow read, write: if false; }
    match /partner_usage/{usageId} { allow read: if isAdmin(); allow write: if false; }
    // Single-use handoff tokens. Readable by nobody: a client that could read
    // these could redeem another user's handoff.
    match /partner_handoffs/{tokenHash} { allow read, write: if false; }

    // SJSU Student Pass: codes and grants are written only by /api/sjsu.
    match /sjsu_codes/{uid} { allow read, write: if false; }
    // Lifecycle email preferences (unsubscribe tokens) and send log: server-only.
    match /email_prefs/{uid} { allow read, write: if false; }
    match /email_log/{uid} { allow read, write: if false; }
    // Content reports and copyright strikes: written and read via the server only.
    match /content_reports/{reportId} { allow read, write: if false; }
    match /moderation/{uid} { allow read, write: if false; }
    match /takedowns/{videoId} { allow read, write: if false; }
    match /sjsu_verifications/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }

    // Portfolio Items: Public read, owner create/update/delete or admin
    match /portfolio_items/{itemId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin())
        && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId || isAdmin());

      // Likes must be a real one-user toggle paired with an exact counter change.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likesCount'])
        && request.resource.data.likedBy is list
        && request.resource.data.likesCount is int
        && request.resource.data.likesCount >= 0
        && (
          (!(request.auth.uid in resource.data.get('likedBy', []))
            && request.auth.uid in request.resource.data.likedBy
            && request.resource.data.likedBy.size() == resource.data.get('likedBy', []).size() + 1
            && request.resource.data.likesCount == resource.data.get('likesCount', 0) + 1)
          ||
          (request.auth.uid in resource.data.get('likedBy', [])
            && !(request.auth.uid in request.resource.data.likedBy)
            && request.resource.data.likedBy.size() == resource.data.get('likedBy', []).size() - 1
            && request.resource.data.likesCount == resource.data.get('likesCount', 0) - 1)
        );

      // Public views and shares are append-only counters. Comment totals may
      // move by one only when a signed-in user creates or removes a comment.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
        && request.resource.data.viewsCount is int
        && request.resource.data.viewsCount == resource.data.get('viewsCount', 0) + 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharesCount'])
        && request.resource.data.sharesCount is int
        && request.resource.data.sharesCount == resource.data.get('sharesCount', 0) + 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount'])
        && request.resource.data.commentsCount is int
        && request.resource.data.commentsCount >= 0
        && (
          request.resource.data.commentsCount == resource.data.get('commentsCount', 0) + 1
          || request.resource.data.commentsCount == resource.data.get('commentsCount', 0) - 1
        );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update: if request.auth != null
          && (resource.data.userId == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow delete: if request.auth != null
          && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Feedback: Authenticated users can create and read their own, Admin can read/manage all
    match /feedback/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
      // After replying, the author may only reopen their own thread for review.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastUserMessageAt'])
        && request.resource.data.status == 'new';

      function isThreadOwner() {
        return request.auth != null
          && get(/databases/$(database)/documents/feedback/$(feedbackId)).data.userId == request.auth.uid;
      }

      // Ongoing replies. Users post as 'user' on their own threads; admins as 'admin'.
      match /messages/{messageId} {
        allow read: if isThreadOwner() || isAdmin();
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && ((request.resource.data.authorRole == 'user' && isThreadOwner())
              || (request.resource.data.authorRole == 'admin' && isAdmin()));
        allow update, delete: if isAdmin();
      }
    }

    // Users: Users can read/write their own document and any subcollections.
    // Allow create if authenticated (even before doc exists).
    // Fields that decide access or billing (see src/lib/plans.ts). Only the
    // server (Admin SDK: Stripe webhook/sync routes) and admins may set them,
    // so a client can never grant itself Pro.
    function entitlementFields() {
      return ['role', 'isPremium', 'tier', 'plan', 'subscriptionStatus',
              'stripeCustomerId', 'stripeSubscriptionId', 'stripePriceId', 'billingUpdatedAt',
              'isVIP', 'unlimitedAccess', 'isStudent'];
    }

    match /users/{userId} {
      allow read: if true;
      // Profiles are public, so they must never hold the account email
      // (Firebase Auth has it). Owners can't add or change one.
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(entitlementFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']);
      allow delete: if request.auth != null && request.auth.uid == userId;
      // A new profile may carry only the default role/plan values.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isPremium', false) == false
        && request.resource.data.get('tier', 'free') in ['free', null]
        && !request.resource.data.keys().hasAny(['plan', 'subscriptionStatus',
              'stripeCustomerId', 'stripeSubscriptionId', 'stripePriceId', 'billingUpdatedAt',
              'isVIP', 'unlimitedAccess', 'isStudent', 'email']);
      allow read, write: if isAdmin();
    }
    // Subcollections only. `{document=**}` directly under {userId} would also
    // match zero segments, i.e. the profile doc itself, and bypass the
    // entitlement guard above.
    match /users/{userId}/{subcollection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // --- Stripe Extension Rules ---

    match /customers/{uid} {
      // stripeId/stripeLink are written by the Stripe extension (Admin SDK) and
      // trusted by the sync routes, so clients may not set them.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['stripeId', 'stripeLink']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stripeId', 'stripeLink']);

      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /stripe_customers/{uid} {
      allow create, read, update: if request.auth != null && request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /products/{id} {
      allow read: if true;
      match /prices/{id} { allow read: if true; }
      match /tax_rates/{id} { allow read: if true; }
    }

    // Portfolios: public read; owners may update their own doc but NOT change
    // username/ownerId (those are managed server-side to guarantee uniqueness).
    // Creation happens through the authenticated API (Admin SDK).
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.username == resource.data.username;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if isAdmin();
    }

    // Username registry: server-managed (Admin SDK bypasses rules)
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Community reference curation rules (open social permissions)
    function boardFollowPath(boardId) {
      return /databases/$(database)/documents/reference_board_follows/$(boardId + '_' + request.auth.uid);
    }

    match /reference_boards/{boardId} {
      // Private boards are visible only to their owner. List queries from
      // other users must filter on isPrivate == false.
      allow read: if resource.data.isPrivate == false
        || (request.auth != null && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid && privacyAllowed();
      allow update: if request.auth != null && (
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && privacyAllowed())
        || isAdmin()
      );
      // Anyone signed in may follow/unfollow: the counter moves by one in the
      // same transaction that creates or deletes their own follow doc.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
        && request.resource.data.followerCount is int
        && (
          (request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
            && !exists(boardFollowPath(boardId)) && existsAfter(boardFollowPath(boardId)))
          ||
          (request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1
            && exists(boardFollowPath(boardId)) && !existsAfter(boardFollowPath(boardId)))
        );
      allow delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /reference_clips/{clipId} {
      // Private clips (studio/NDA uploads) are visible only to their creator.
      // List queries from other users must filter on isPrivate == false.
      allow read: if resource.data.isPrivate == false
        || (request.auth != null && resource.data.creatorId == request.auth.uid)
        || isAdmin();
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid && privacyAllowed();
      // A clip removed after a report stays private: only an admin (or a
      // counter-notice handled by an admin) can restore it.
      allow update: if request.auth != null && (
        (resource.data.creatorId == request.auth.uid && request.resource.data.creatorId == resource.data.creatorId && privacyAllowed()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['takenDownAt', 'takenDownReason'])
          && (resource.data.get('takenDownAt', null) == null || request.resource.data.get('isPrivate', false) == true))
        || isAdmin()
      );
      // Saving another creator's clip to your board moves its save counter by one.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saveCount'])
        && request.resource.data.saveCount is int
        && (
          request.resource.data.saveCount == resource.data.get('saveCount', 0) + 1
          || request.resource.data.saveCount == resource.data.get('saveCount', 0) - 1
        );
      allow delete: if request.auth != null && (resource.data.creatorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 1000;
        allow update: if request.auth != null
          && (resource.data.userId == request.auth.uid || isAdmin())
          && request.resource.data.userId == resource.data.userId;
        allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      }
      // One like per user: the doc id is the liker's uid.
      match /likes/{likeId} {
        allow read: if true;
        allow create, delete: if request.auth != null && (likeId == request.auth.uid || isAdmin());
      }
    }

    function isBoardOwner(boardId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/reference_boards/$(boardId)).data.ownerId == request.auth.uid;
    }

    // Only a board's owner may add or remove clips from it.
    match /reference_board_saves/{saveId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && isBoardOwner(request.resource.data.boardId);
      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isBoardOwner(resource.data.boardId) || isAdmin());
      allow update: if isAdmin();
    }

    // Follow doc ids are `${boardId}_${userId}`; users manage only their own.
    match /reference_board_follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && followId == request.resource.data.boardId + '_' + request.auth.uid;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /shot_breakdowns/{breakdownId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // --- Production Studio: crews, onboarding, chat, public showcase ---

    function isProjectOwner(projectId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/production_projects/$(projectId)).data.ownerId == request.auth.uid;
    }
    function isProjectCrew(projectId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/production_projects/$(projectId)/crew/$(request.auth.uid));
    }
    function isProjectPublic(projectId) {
      return get(/databases/$(database)/documents/production_projects/$(projectId)).data.isPublic == true;
    }

    match /production_projects/{projectId} {
      allow read: if resource.data.isPublic == true
        || (request.auth != null && resource.data.ownerId == request.auth.uid)
        || (request.auth != null && request.auth.uid in resource.data.teamMemberIds)
        || isAdmin();
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if (request.auth != null && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /crew/{userId} {
        allow read: if isProjectPublic(projectId) || isProjectOwner(projectId) || isProjectCrew(projectId) || isAdmin();
        allow create, delete: if isProjectOwner(projectId) || isAdmin();
        allow update: if (request.auth != null && request.auth.uid == userId) || isProjectOwner(projectId) || isAdmin();
      }
      match /tasks/{taskId} {
        allow read: if isProjectPublic(projectId) || isProjectOwner(projectId) || isProjectCrew(projectId) || isAdmin();
        allow write: if isProjectOwner(projectId) || isProjectCrew(projectId) || isAdmin();

        match /comments/{commentId} {
          allow read, create: if isProjectOwner(projectId) || isProjectCrew(projectId) || isAdmin();
          allow update, delete: if isAdmin();
        }
      }
      match /messages/{messageId} {
        allow read, create: if isProjectOwner(projectId) || isProjectCrew(projectId) || isAdmin();
        allow update: if (isProjectOwner(projectId) || isProjectCrew(projectId) || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'linkedTaskId', 'linkedTaskTitle', 'resolved', 'resolvedByName']);
        allow delete: if isAdmin();
      }
      match /activity/{activityId} {
        allow read, create: if isProjectOwner(projectId) || isProjectCrew(projectId) || isAdmin();
      }
    }

    match /notifications/{notificationId} {
      allow create: if request.auth != null &&
        (isProjectOwner(request.resource.data.projectId) || isProjectCrew(request.resource.data.projectId) || isAdmin());
      allow read, update: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /crew_applications/{applicationId} {
      allow create: if request.auth != null && request.resource.data.applicantId == request.auth.uid;
      allow read: if request.auth != null && (resource.data.applicantId == request.auth.uid
        || get(/databases/$(database)/documents/production_projects/$(resource.data.projectId)).data.ownerId == request.auth.uid
        || isAdmin());
      allow update: if request.auth != null &&
        (get(/databases/$(database)/documents/production_projects/$(resource.data.projectId)).data.ownerId == request.auth.uid
        || isAdmin());
    }
  }
}
