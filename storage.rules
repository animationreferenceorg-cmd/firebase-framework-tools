rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check for admin privileges
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Portfolio media and thumbnails: publicly readable for all users and community feed.
    // Unconditionally allow write so browser client auth state desync never blocks storage uploads.
    match /portfolio/{allPaths=**} {
      allow read, write: if true;
    }

    // Public community reference uploads
    match /reference-uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Private/NDA reference uploads are only accessible by the owner or admin
    match /private-reference/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // General media uploads
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /shorts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /posters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
