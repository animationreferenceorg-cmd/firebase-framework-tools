# AnimationReference.org environment variables — names only, never real values.
# Copy to .env.local for local development. In production (Firebase App
# Hosting) secrets live in Secret Manager and are listed in apphosting.yaml.
# The Firebase web client config is public and lives in src/lib/firebase.ts.

# --- Stripe billing (required for checkout, portal, webhook) ----------------
# Secret API key (sk_live_… / sk_test_…). Server only.
STRIPE_SECRET_KEY=
# Signing secret of the endpoint https://<site>/api/webhooks/stripe (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Pro prices (price_…). Public IDs, needed at build time and runtime.
# Monthly should be the $9/month price, annual the $79/year price.
# Unset monthly => checkout falls back to the legacy $5 price and shows $5.
# Unset annual  => the annual option is hidden and annual checkout is refused.
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=
# Publishable key (pk_live_… / pk_test_…). Required for on-site embedded checkout modal.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Firebase Admin (server) ------------------------------------------------
# On App Hosting / Cloud Run these come from the runtime service account and
# can be left unset. Locally, prefer `gcloud auth application-default login`
# over a downloaded key; never commit a private key.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
SITE_URL=
# Comma-separated extra origins allowed to call partner APIs.
PARTNER_ALLOWED_ORIGINS=

# --- Media -----------------------------------------------------------------
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
NEXT_PUBLIC_BUNNY_LIBRARY_ID=
NEXT_PUBLIC_BUNNY_STREAM_HOST=
# Local tools used by the downloader (optional).
FFMPEG_PATH=
PYTHON_PATH=

# --- AI (Genkit / Gemini) --------------------------------------------------
GOOGLE_GENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Scheduled jobs / social auto-poster (optional) -------------------------
CRON_SECRET=
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_PERSON_URN=

# --- Tests -----------------------------------------------------------------
# Run Playwright against another server instead of starting `next dev`.
PLAYWRIGHT_BASE_URL=
# Use an installed browser (msedge, chrome) instead of downloading Chromium.
PLAYWRIGHT_CHANNEL=

# Optional intro offer: first month of Pro monthly at this price (cents), via this Stripe coupon
NEXT_PUBLIC_PRO_INTRO_FIRST_MONTH_CENTS=
STRIPE_PRO_INTRO_COUPON_ID=
